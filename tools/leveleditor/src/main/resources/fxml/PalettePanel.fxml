<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.sgl.editor.ui.panels.PalettePanelController"
      spacing="6" styleClass="panel">
    <Label text="Kachelpalette" styleClass="panel-title"/>
    <ComboBox fx:id="tilesetChoice" maxWidth="Infinity"/>
    <Button text="Tileset importieren…" onAction="#onImport" maxWidth="Infinity"/>
    <ScrollPane fx:id="scroll" VBox.vgrow="ALWAYS" fitToWidth="true">
        <Canvas fx:id="canvas"/>
    </ScrollPane>
    <Label fx:id="wangLabel" styleClass="dim" wrapText="true"/>
    <Label fx:id="infoLabel" styleClass="dim"/>
</VBox>
